PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Data source: true = in-memory mock (default). false = MySQL implementations in services/implementations/*.mysql.js
USE_MOCK_DATA=true

# MySQL (used when USE_MOCK_DATA=false)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=arbscanner
