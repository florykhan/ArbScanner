# =============================================================================
# ArbScanner — environment template (copy to `.env` at repo root for local dev;
# on Render, set these in the service "Environment" tab).
# =============================================================================

# --- MySQL (required for API and sync jobs) ---
ARBSCANNER_DB_HOST=localhost
ARBSCANNER_DB_PORT=3306
ARBSCANNER_DB_USER=root
ARBSCANNER_DB_PASSWORD=your_mysql_password_here
ARBSCANNER_DB_NAME=ArbScannerDB

# Optional: Unix socket instead of TCP (local installs)
# ARBSCANNER_DB_SOCKET=/path/to/mysql.sock

# Optional: TCP connect timeout in seconds (default 10). Useful for remote DBs.
# ARBSCANNER_DB_CONNECT_TIMEOUT=15

# Optional: set to `true` if your MySQL has no TLS (typical local). Omit on Render
# if the provider expects SSL (mysql-connector negotiates TLS by default).
# ARBSCANNER_DB_SSL_DISABLED=true

# --- HTTP API (local: `python3 -m backend.run_api`) ---
# Render injects PORT automatically — the app listens on 0.0.0.0 when PORT is set.
# ARBSCANNER_API_PORT=3001
# ARBSCANNER_API_HOST=127.0.0.1
# ARBSCANNER_API_RELOAD=1

# --- CORS (required when frontend is on another origin, e.g. Vercel) ---
# Production frontend origin (no path), e.g. https://arbscanner.vercel.app
# FRONTEND_URL=

# Extra allowed browser origins (comma-separated). Use for preview deployments.
# ARBSCANNER_CORS_ORIGINS=https://branch-foo.vercel.app,https://arbscanner.vercel.app

# --- External market data (optional for API-only hosting) ---
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_USER_AGENT=Mozilla/5.0 ArbScanner/0.1
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

MANIFOLD_API_BASE_URL=https://api.manifold.markets/v0
MANIFOLD_USER_AGENT=Mozilla/5.0 ArbScanner/0.1

KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_USER_AGENT=Mozilla/5.0 ArbScanner/0.1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_USER_AGENT=Mozilla/5.0 ArbScanner/0.1
GEMINI_MAX_WORKERS=8
GEMINI_MAX_CANDIDATE_PAIRS=300
GEMINI_ENABLED=true
