# =============================================================================
# ArbScanner frontend (Vite) — copy to `frontend/.env` for local dev.
# On Vercel, set the same keys in Project → Settings → Environment Variables.
# =============================================================================

# --- API base URL ---
# Local dev: leave empty so the browser calls `/api/...` on the Vite origin and
# the dev server proxies to FastAPI (see `vite.config.ts`).
VITE_API_BASE_URL=

# Legacy name (optional): same meaning as VITE_API_BASE_URL if the above is unset.
# VITE_API_URL=

# Optional: if your API runs on a non-default host/port during local dev.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:3001

# --- Production example (Vercel → Render) ---
# VITE_API_BASE_URL=https://your-service-name.onrender.com
